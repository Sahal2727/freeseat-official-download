<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light Theme Colors -->
    <Color x:Key="PrimaryColor">#0078D4</Color>
    <Color x:Key="PrimaryHoverColor">#106EBE</Color>
    <Color x:Key="PrimaryPressedColor">#005A9E</Color>
    
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#F3F2F1</Color>
    <Color x:Key="SurfaceHoverColor">#EDebe9</Color>
    <Color x:Key="SurfacePressedColor">#E1DFDD</Color>
    
    <Color x:Key="TextPrimaryColor">#323130</Color>
    <Color x:Key="TextSecondaryColor">#605E5C</Color>
    <Color x:Key="TextDisabledColor">#A19F9D</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>
    
    <Color x:Key="BorderColor">#D2D0CE</Color>
    <Color x:Key="BorderHoverColor">#8A8886</Color>
    
    <Color x:Key="SuccessColor">#107C10</Color>
    <Color x:Key="WarningColor">#B46900</Color>
    <Color x:Key="ErrorColor">#D13438</Color>
    <Color x:Key="InfoColor">#0078D4</Color>
    
    <!-- Dark Theme Colors -->
    <Color x:Key="PrimaryColorDark">#168BFF</Color>
    <Color x:Key="PrimaryHoverColorDark">#3A9BFF</Color>
    <Color x:Key="PrimaryPressedColorDark">#0870DC</Color>
    
    <Color x:Key="BackgroundColorDark">#0B1420</Color>
    <Color x:Key="SurfaceColorDark">#111D2B</Color>
    <Color x:Key="SurfaceHoverColorDark">#182738</Color>
    <Color x:Key="SurfacePressedColorDark">#203146</Color>
    
    <Color x:Key="TextPrimaryColorDark">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColorDark">#B7C4D2</Color>
    <Color x:Key="TextDisabledColorDark">#8593A5</Color>
    <Color x:Key="TextOnPrimaryColorDark">#FFFFFF</Color>
    
    <Color x:Key="BorderColorDark">#26384A</Color>
    <Color x:Key="BorderHoverColorDark">#405A74</Color>
    
    <Color x:Key="SuccessColorDark">#34D399</Color>
    <Color x:Key="WarningColorDark">#FBBF24</Color>
    <Color x:Key="ErrorColorDark">#FB7185</Color>
    <Color x:Key="InfoColorDark">#38BDF8</Color>
    
    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{DynamicResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{DynamicResource PrimaryPressedColor}"/>
    
    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{DynamicResource SurfacePressedColor}"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{DynamicResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{DynamicResource TextOnPrimaryColor}"/>
    
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{DynamicResource BorderHoverColor}"/>
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}"/>
    <Color x:Key="NavigationSelectedColor">#E6F2FC</Color>
    <Color x:Key="LogoStandColor">#000000</Color>
    <SolidColorBrush x:Key="NavigationSelectedBrush" Color="{DynamicResource NavigationSelectedColor}"/>
    <SolidColorBrush x:Key="LogoStandBrush" Color="{DynamicResource LogoStandColor}"/>

    <!-- Font Families -->
    <FontFamily x:Key="DefaultFontFamily">Segoe UI Variable, Segoe UI, system-ui</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Code, Consolas, monospace</FontFamily>
</ResourceDictionary>
